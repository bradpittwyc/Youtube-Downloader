{
  "name": "youtube-downloader",
  "version": "1.0.0",
  "description": "YouTube 频道批量下载器：粘贴博主主页，自动识别 Videos / Shorts / Live / Podcasts 并批量下载",
  "main": "src/main/main.js",
  "author": "youtube-downloader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tools/integration-test.js",
    "pack": "electron-builder --win --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ytdl.desktop.downloader",
    "productName": "YouTube Downloader",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube 下载器",
      "uninstallDisplayName": "YouTube 下载器",
      "deleteAppDataOnUninstall": false,
      "artifactName": "YouTubeDownloader-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "YouTubeDownloader-Portable-${version}.exe"
    }
  }
}
