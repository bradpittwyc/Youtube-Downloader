{
  "name": "youtube-downloader",
  "version": "1.20.4",
  "description": "YouTube 频道批量下载器 + 中英对照学习文档生成",
  "main": "src/main/main.js",
  "author": "youtube-downloader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tools/integration-test.js",
    "pack": "electron-builder --win --dir",
    "dist": "node tools/safe-build.js && electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ytdl.desktop.downloader",
    "productName": "YouTube Downloader",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "YouTubeDownloader-Green-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YouTube 下载器",
      "uninstallDisplayName": "YouTube 下载器",
      "deleteAppDataOnUninstall": false,
      "artifactName": "YouTubeDownloader-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "license": "build/license.txt",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "runAfterFinish": true,
      "menuCategory": false,
      "allowElevation": true
    },
    "portable": {
      "artifactName": "YouTubeDownloader-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "docx": "^9.7.1"
  }
}
